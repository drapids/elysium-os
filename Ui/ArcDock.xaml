<Window x:Class="Heft.Ui.ArcDock"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Width="360" Height="760" Title="heft dock"
        FontFamily="{StaticResource UiFont}">

    <Grid x:Name="root" Background="#01000000">
        <Canvas x:Name="layers"/>
        <Canvas x:Name="overlay">
            <Border x:Name="hoverPill" Style="{StaticResource Pill}" IsHitTestVisible="False" Opacity="0">
                <TextBlock x:Name="hoverText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                           MaxWidth="240" TextTrimming="CharacterEllipsis"/>
            </Border>
            <TextBlock x:Name="emptyText" FontSize="13" Foreground="{DynamicResource SubText}" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Border x:Name="crumb" Style="{StaticResource Pill}" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="back" Style="{StaticResource Plain}" Width="26" Height="26" ToolTip="zoom out">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="11"/>
                    </Button>
                    <StackPanel VerticalAlignment="Center" Margin="6,0,8,0">
                        <TextBlock x:Name="crumbTitle" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                   MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="crumbHint" FontSize="10.5" Foreground="{DynamicResource SubText}"/>
                    </StackPanel>
                    <Button x:Name="sortBtn" Style="{StaticResource Plain}" Width="26" Height="26">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8CB;" FontSize="11"/>
                    </Button>
                    <Button x:Name="openHere" Style="{StaticResource Plain}" Width="26" Height="26" ToolTip="open in File Explorer">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="11"/>
                    </Button>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
