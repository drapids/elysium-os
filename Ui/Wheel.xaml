<Window x:Class="Heft.Ui.Wheel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Width="480" Height="480" Title="heft wheel"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">

    <Grid x:Name="root" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="pop" ScaleX="0.9" ScaleY="0.9"/>
        </Grid.RenderTransform>

        <Ellipse Width="440" Height="440" Fill="{DynamicResource WheelBg}">
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.35" Color="Black"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="440" Height="440" Stroke="{DynamicResource Stroke}" StrokeThickness="1" IsHitTestVisible="False"/>
        <Ellipse Width="320" Height="320" Stroke="{DynamicResource Stroke}" StrokeThickness="1" StrokeDashArray="1 5" IsHitTestVisible="False"/>

        <Canvas x:Name="spin" Width="440" Height="440">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="rot" CenterX="220" CenterY="220"/>
            </Canvas.RenderTransform>
        </Canvas>

        <Border Width="22" Height="4" CornerRadius="2" Background="{DynamicResource AccentFill}"
                VerticalAlignment="Top" Margin="0,30,0,0" IsHitTestVisible="False"/>

        <Ellipse x:Name="hub" Width="172" Height="172" Fill="{DynamicResource CardBg}" Stroke="{DynamicResource Stroke}" StrokeThickness="1" Cursor="Hand"/>
        <StackPanel Width="148" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Image x:Name="hubIcon" Width="40" Height="40" Margin="0,0,0,8"/>
            <TextBlock x:Name="hubName" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                       TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="hubKind" FontSize="11.5" Foreground="{DynamicResource SubText}" TextAlignment="Center" Margin="0,2,0,0"/>
            <TextBlock x:Name="hubHint" FontSize="11" Foreground="{DynamicResource Faint}" TextAlignment="Center" Margin="0,10,0,0"
                       Text="spin it, then click or hit enter"/>
        </StackPanel>
    </Grid>
</Window>
