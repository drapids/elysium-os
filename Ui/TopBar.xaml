<Window x:Class="Heft.Ui.TopBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        WindowStartupLocation="Manual" Width="800" Height="30" Title="heft bar" AllowDrop="True"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <Grid x:Name="root" Background="#01000000">
        <Border x:Name="tint"/>
        <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource GroupStroke}"/>
        <Grid Margin="14,0,8,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="appName" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                           Margin="0,0,16,0" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <StackPanel x:Name="media" Orientation="Horizontal" Background="#01000000" Cursor="Hand" VerticalAlignment="Center"
                            ToolTip="click to play or pause">
                    <TextBlock x:Name="mediaGlyph" Style="{StaticResource Icon}" Text="&#xE768;" FontSize="10" Margin="0,1,7,0"/>
                    <TextBlock x:Name="mediaText" FontSize="12" Foreground="{DynamicResource SubText}" MaxWidth="360"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock x:Name="date" FontSize="12.5" Foreground="{DynamicResource SubText}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="clock" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="flash" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,0,16,0" Opacity="0"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Border x:Name="stackPill" CornerRadius="8" Padding="8,1,8,2" Margin="0,0,14,0" Background="{DynamicResource AccentFill}"
                        VerticalAlignment="Center" Visibility="Collapsed" ToolTip="paste stack is on. ctrl + alt + v pastes the next one">
                    <TextBlock x:Name="stackText" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource OnAccent}"/>
                </Border>
                <TextBlock x:Name="stats" FontSize="12" Foreground="{DynamicResource SubText}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <StackPanel x:Name="vol" Orientation="Horizontal" Background="#01000000" Margin="0,0,14,0" VerticalAlignment="Center"
                            ToolTip="scroll anywhere on the bar to change volume. click to mute">
                    <TextBlock x:Name="volGlyph" Style="{StaticResource Icon}" Text="&#xE767;" FontSize="12" Margin="0,0,6,0"/>
                    <TextBlock x:Name="volText" FontSize="12" Foreground="{DynamicResource SubText}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="bat" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="batGlyph" Style="{StaticResource Icon}" Text="&#xE83F;" FontSize="13" Margin="0,0,6,0"/>
                    <TextBlock x:Name="batText" FontSize="12" Foreground="{DynamicResource SubText}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="shelfBtn" Style="{StaticResource Plain}" Width="26" Height="22" ToolTip="shelf (or drag down from the bar)">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
